<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_event_card"
    android:padding="@dimen/spacing_large">

    <ImageView
        android:id="@+id/imgCard"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_image_height"
        android:scaleType="centerCrop"
        android:contentDescription="@string/home_image_description"
        tools:src="@drawable/velada_2027" />

    <TextView
        android:id="@+id/txtCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/card_title_size"
        android:textStyle="bold"
        tools:text="@string/home_title" />

    <TextView
        android:id="@+id/txtCardSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/card_subtitle_size"
        tools:text="@string/home_subtitle" />

    <TextView
        android:id="@+id/txtCardDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/card_description_size"
        tools:text="@string/home_description" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_section"
        android:text="@string/card_info_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/card_section_title_size"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- BLOQUE FECHA -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_info_box"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <!-- Icono y Título de FECHA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/card_info_icon_size"
                    android:layout_height="@dimen/card_info_icon_size"
                    android:layout_marginEnd="@dimen/card_icon_spacing"
                    android:src="@drawable/ic_date"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    app:tint="@color/accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_date_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/card_info_text_size" />

            </LinearLayout>

            <!-- Campo de texto de FECHA -->
            <TextView
                android:id="@+id/txtCardDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/card_date_text"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/card_info_text_size"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- BLOQUE LUGAR -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_medium"
            android:background="@drawable/bg_info_box"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <!-- Icono y Título de LUGAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/card_info_icon_size"
                    android:layout_height="@dimen/card_info_icon_size"
                    android:layout_marginEnd="@dimen/card_icon_spacing"
                    android:src="@drawable/ic_location"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    app:tint="@color/accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_location_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/card_info_text_size" />

            </LinearLayout>

            <!-- Campo de texto de LUGAR -->
            <TextView
                android:id="@+id/txtCardLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/card_location_text"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/card_info_text_size"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- BLOQUE CATEGORÍAS -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_section"
        android:text="@string/card_categories_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/card_section_title_size"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtCategory1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_info_box"
            android:padding="@dimen/spacing_medium"
            android:text="@string/card_category_boxing"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/card_info_text_size" />

        <TextView
            android:id="@+id/txtCategory2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:background="@drawable/bg_info_box"
            android:padding="@dimen/spacing_medium"
            android:text="@string/card_category_entertainment"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/card_info_text_size" />

    </LinearLayout>

</LinearLayout>
